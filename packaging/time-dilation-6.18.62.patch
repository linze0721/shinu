+/*
+ * /sys/kernel/lcb_time/{scale,sync_realtime,virtual_offset_ns}
+ */
+static int lcb_time_set_scale(u32 new_scale)
+{
+	struct timekeeper *tks = &tk_core.shadow_timekeeper;
+	unsigned long flags;
+	u32 old_scale;
+	u64 hw_now, d_hw, extra_ns = 0;
+
+	if (new_scale < 1 || new_scale > 10)
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&tk_core.lock, flags);
+	old_scale = (u32)atomic_read(&lcb_time_scale);
+	if (old_scale == new_scale) {
+		raw_spin_unlock_irqrestore(&tk_core.lock, flags);
+		return 0;
+	}
+
+	/* Fold elapsed virtual cycles at old_scale into timekeeper bases first. */
+	timekeeping_forward_now(tks);
+
+	hw_now = tks->tkr_mono.clock->read(tks->tkr_mono.clock);
+	if (old_scale > 1) {
+		u64 mask = tks->tkr_mono.mask;
+		d_hw = (hw_now - lcb_dilation[0].hw_base) & mask;
+		if (d_hw & ~(mask >> 1))
+			d_hw = 0;
+		extra_ns = mul_u64_u32_shr(d_hw * (u64)(old_scale - 1),
+					  tks->tkr_mono.mult, tks->tkr_mono.shift);
+		atomic64_add((s64)extra_ns, &lcb_virtual_offset_ns);
+		if (!atomic_read(&lcb_sync_realtime) && extra_ns > 0) {
+			struct timespec64 delta = ns_to_timespec64((s64)extra_ns);
+			struct timespec64 xt = {
+				.tv_sec = tks->xtime_sec,
+				.tv_nsec = (long)(tks->tkr_mono.xtime_nsec >> tks->tkr_mono.shift),
+			};
+			xt = timespec64_sub(xt, delta);
+			tk_set_xtime(tks, &xt);
+			tk_set_wall_to_mono(tks, timespec64_add(tks->wall_to_monotonic, delta));
+		}
+	}
+
+	/* Rebase cycle_last and dilation anchors to raw hw_now for zero-jump continuity and native vDSO at 1x. */
+	tks->tkr_mono.cycle_last = hw_now;
+	tks->tkr_raw.cycle_last = hw_now;
+	lcb_dilation_write_locked(hw_now, hw_now, new_scale);
+
+	timekeeping_update_from_shadow(&tk_core, TK_CLOCK_WAS_SET);
+	raw_spin_unlock_irqrestore(&tk_core.lock, flags);
+
+	clock_was_set(CLOCK_SET_WALL | CLOCK_SET_BOOT);
+	hrtimer_lcb_retrigger_all();
+	return 0;
+}
+
+static ssize_t lcb_scale_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", lcb_time_get_scale());
+}
+
+static ssize_t lcb_scale_store(struct kobject *kobj, struct kobj_attribute *attr,
+			       const char *buf, size_t count)
+{
+	u32 val;
+	int err;
+
+	err = kstrtou32(buf, 10, &val);
+	if (err)
+		return err;
+	err = lcb_time_set_scale(val);
+	return err ? err : (ssize_t)count;
+}
+
+static ssize_t lcb_sync_realtime_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", atomic_read(&lcb_sync_realtime));
+}
+
+static ssize_t lcb_sync_realtime_store(struct kobject *kobj, struct kobj_attribute *attr,
+				       const char *buf, size_t count)
+{
+	u32 val;
+	int err;
+
+	err = kstrtou32(buf, 10, &val);
+	if (err || val > 1)
+		return -EINVAL;
+	atomic_set(&lcb_sync_realtime, (int)val);
+	return (ssize_t)count;
+}
+
+static ssize_t lcb_virtual_offset_ns_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%lld\n", (long long)atomic64_read(&lcb_virtual_offset_ns));
+}
+
+static struct kobj_attribute lcb_scale_attr = __ATTR(scale, 0600, lcb_scale_show, lcb_scale_store);
+static struct kobj_attribute lcb_sync_realtime_attr = __ATTR(sync_realtime, 0600, lcb_sync_realtime_show, lcb_sync_realtime_store);
+static struct kobj_attribute lcb_virtual_offset_attr = __ATTR(virtual_offset_ns, 0444, lcb_virtual_offset_ns_show, NULL);
+
+static struct attribute *lcb_time_attrs[] = {
+	&lcb_scale_attr.attr,
+	&lcb_sync_realtime_attr.attr,
+	&lcb_virtual_offset_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group lcb_time_group = {
+	.attrs = lcb_time_attrs,
+};
+
+static int __init lcb_time_sysfs_init(void)
+{
+	struct kobject *kobj = kobject_create_and_add("lcb_time", kernel_kobj);
+	if (!kobj)
+		return -ENOMEM;
+	return sysfs_create_group(kobj, &lcb_time_group);
+}
+late_initcall(lcb_time_sysfs_init);
