+		unsigned int seq;
+		u64 virt;
+		u64 mask = tkr->mask;
+
+		do {
+			const struct lcb_dilation_base *b;
+
+			seq = read_seqcount_latch(&lcb_dilation_seq);
+			b = &lcb_dilation[seq & 1];
+			if (b->scale <= 1) {
+				virt = hw;
+			} else {
+				u64 d = (hw - b->hw_base) & mask;
+				if (d & ~(mask >> 1))
+					d = 0;
+				virt = (b->virt_base + d * (u64)b->scale) & mask;
+			}
+		} while (read_seqcount_latch_retry(&lcb_dilation_seq, seq));
+		return virt;
+	}
+	return hw;
 }
 
