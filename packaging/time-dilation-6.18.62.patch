+/*
+ * LeapCaseBench kernel-level time dilation (1x..10x).
+ * Keeps hardware clocksource and clocksource_watchdog untouched.
+ */
+struct lcb_dilation_base {
+	u64 hw_base;
+	u64 virt_base;
+	u32 scale;
+};
+
+static seqcount_latch_t lcb_dilation_seq = SEQCNT_LATCH_ZERO(lcb_dilation_seq);
+static struct lcb_dilation_base lcb_dilation[2] = {
+	{ .hw_base = 0, .virt_base = 0, .scale = 1 },
+	{ .hw_base = 0, .virt_base = 0, .scale = 1 },
+};
+static atomic_t lcb_time_scale = ATOMIC_INIT(1);
+static atomic_t lcb_sync_realtime = ATOMIC_INIT(1);
+static atomic64_t lcb_virtual_offset_ns = ATOMIC64_INIT(0);
+
+u32 lcb_time_get_scale(void)
+{
+	return (u32)atomic_read(&lcb_time_scale);
+}
+
+static void lcb_dilation_write_locked(u64 hw_base, u64 virt_base, u32 scale)
+{
+	write_seqcount_latch_begin(&lcb_dilation_seq);
+	lcb_dilation[0].hw_base = hw_base;
+	lcb_dilation[0].virt_base = virt_base;
+	lcb_dilation[0].scale = scale;
+	write_seqcount_latch(&lcb_dilation_seq);
+	lcb_dilation[1].hw_base = hw_base;
+	lcb_dilation[1].virt_base = virt_base;
+	lcb_dilation[1].scale = scale;
+	write_seqcount_latch_end(&lcb_dilation_seq);
+	atomic_set(&lcb_time_scale, (int)scale);
+}
+
