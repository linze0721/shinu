# TLS terminates at Caddy; keep shinud on cleartext loopback HTTP.
#
# `flush_interval -1` is required for chunked NDJSON from `shinu exec` to
# reach clients as it is produced instead of waiting for buffering or exit.

api.example.com {
	reverse_proxy 127.0.0.1:7878 {
		# Flush upstream chunks immediately for NDJSON streaming.
		flush_interval -1

		# Keep the upstream transport inside the reverse proxy block.
		transport http {
			# Commands may be silent for an unbounded interval while running.
			read_timeout 0
			dial_timeout 5s
		}
	}
}
