---
import { Icon } from "astro-icon/components";
import { brand, repo } from "../content/facts";

const year = new Date().getFullYear();

const anchors = [
  { href: "#primitives", label: "Primitives" },
  { href: "#workflow", label: "Workflow" },
  { href: "#isolation", label: "Isolation" },
  { href: "#numbers", label: "Numbers" },
  { href: "#start", label: "Start" },
] as const;

const link =
  "press group inline-flex items-center gap-2 text-sm text-ink-soft underline-offset-4 transition-colors hover:text-ink hover:underline";
---

<footer class="shell pb-12">
  <div class="rule-t pt-12">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[auto_1fr_auto] md:items-start md:gap-16">
      <div>
        <p class="font-mono text-lg text-ink">{brand.name}</p>
        <p class="mt-3 text-sm text-ink-soft">{brand.parentLine}</p>
        <p class="machine mt-6">Copyright {year} {brand.parent}</p>
      </div>
      <nav aria-label="Sections">
        <ul class="flex flex-wrap gap-x-6 gap-y-3 md:justify-center">
          {
            anchors.map((a) => (
              <li>
                <a
                  href={a.href}
                  class="press text-sm text-ink-soft underline-offset-4 transition-colors hover:text-ink hover:underline"
                >
                  {a.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:justify-self-end">
        <ul class="space-y-3">
          {
            repo && (
              <li>
                <a href={repo} class={link} rel="noopener noreferrer">
                  <Icon name="ph:git-branch" class="size-4 transition-colors group-hover:text-jade-600" />
                  Source
                </a>
              </li>
            )
          }
          <li>
            <a href={`mailto:${brand.contact}`} class={link}>
              <Icon name="ph:envelope-simple" class="size-4 transition-colors group-hover:text-jade-600" />
              {brand.contact}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
